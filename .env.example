# .env.example
# Copy this to .env and fill in your values for local development

# Database connection (will be auto-provided by Railway in production)
DATABASE_URL=postgresql://username:***@localhost:5432/sporedrop

# Force catalog reload on boot even when species.py hash matches (rare)
# CATALOG_FORCE_SYNC=1

# App settings
PORT=8793

# Cloudflare (Phase 3 CDN purge-on-catalog-change)
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
CLOUDFLARE_ZONE_ID=your_zone_id

# Gemini AI (optional)
GEMINI_API_KEY=your_gemini_api_key